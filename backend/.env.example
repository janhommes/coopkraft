# CoopKraft Backend – Konfiguration. Kopieren nach backend/.env (lokal) bzw. als Secrets im Deploy.

# Öffentliche Adresse der App (ohne /api), für den SSO-Rücksprung
APP_URL=https://mitglieder.example.de
# Pfad der API unter APP_URL
BASE_PATH=/api
# Fehlerdetails in Antworten (nur lokal)
APP_DEBUG=false

# Datenbank (MySQL 8 / MariaDB 10.5+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coopkraft
DB_USER=coopkraft
DB_PASSWORD=

# Anmeldung: oidc (SSO, z. B. Nextcloud) oder dev (Formular "SSO simulieren", nur lokal!)
AUTH_MODE=oidc
# Nextcloud mit App "OIDC Identity Provider": https://cloud.example.de/index.php
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Scopes; der Gruppen-Claim heißt wie in "Rollen & SSO-Zuordnung" eingestellt (Standard: groups)
OIDC_SCOPES=openid email profile groups
# Client-Authentifizierung am Token-Endpunkt: basic oder post
OIDC_TOKEN_AUTH=basic

# Notfall-Admins (kommagetrennt), z. B. für die Ersteinrichtung bevor SSO-Gruppen gepflegt sind
ADMIN_EMAILS=

# Session-Cookie nur über HTTPS (lokal ohne HTTPS: false)
COOKIE_SECURE=true
